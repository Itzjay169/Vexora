# Application Configuration
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
CLIENT_WEB_URL=http://localhost:3000
ADMIN_WEB_URL=http://localhost:3001

# PostgreSQL Database
DATABASE_URL=postgresql://vexora_user:vexora_password@localhost:5432/vexora_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# Redis Cache & Pub/Sub
REDIS_URL=redis://localhost:6379

# JWT & Authentication Secrets (HMAC SHA-256)
JWT_ACCESS_SECRET=vexora_super_secret_access_key_min_32_chars_long_12345
JWT_REFRESH_SECRET=vexora_super_secret_refresh_key_min_32_chars_long_12345
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Redeem Code Encryption & Checksum Secret
REDEEM_CODE_HMAC_SECRET=vexora_secure_redeem_hmac_secret_key_889900
AUDIT_MERKLE_SALT=vexora_audit_tamper_evident_salt_2026

# Firebase Credentials
FIREBASE_PROJECT_ID=vexora-esports-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@vexora-esports-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="placeholder_firebase_private_key_replace_with_actual_in_local_env"
FIREBASE_APP_CHECK_ENFORCED=false

# Object Storage (S3 / MinIO compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_EVIDENCE=vexora-evidence
S3_BUCKET_KYC=vexora-kyc-secure
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Payment Gateway (Razorpay / Stripe)
PAYMENT_WEBHOOK_SECRET=whsec_vexora_test_webhook_signature_secret_9988
PAYMENT_MERCHANT_KEY=rzp_test_placeholder_key

# Feature Flags
FLAG_REAL_MONEY_ENABLED=false
FLAG_MAINTENANCE_MODE=false
